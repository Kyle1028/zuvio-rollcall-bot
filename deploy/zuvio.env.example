# ── Zuvio bot 機密設定範本 ──
# 用法：複製到 /etc/zuvio.env，填入真實值，並鎖權限：
#   sudo cp deploy/zuvio.env.example /etc/zuvio.env
#   sudo nano /etc/zuvio.env
#   sudo chmod 600 /etc/zuvio.env
#   sudo chown root:root /etc/zuvio.env
#
# 這些變數會「覆蓋」settings.json，所以 settings.json 裡可以完全不放帳密。

# Zuvio 帳號（Email）與密碼（必填）
ZUVIO_USER=you@example.com
ZUVIO_PASS=your-zuvio-password

# LINE 通知（選填；兩個都填才會自動啟用通知）
# Channel access token：LINE Developers → 你的 Messaging API channel → Messaging API 分頁 → Issue
# User ID：同一個 channel 的 Basic settings 分頁最下方「Your user ID」（U 開頭）
# 記得用手機把這個官方帳號加為好友，否則推播會失敗。
ZUVIO_LINE_TOKEN=your_channel_access_token
ZUVIO_LINE_USER_ID=U0123456789abcdef0123456789abcdef
