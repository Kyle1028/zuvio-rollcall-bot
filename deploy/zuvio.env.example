# ── Zuvio bot 機密設定範本 ──
# 用法：複製到 /etc/zuvio.env，填入真實值，並鎖權限：
#   sudo cp deploy/zuvio.env.example /etc/zuvio.env
#   sudo nano /etc/zuvio.env
#   sudo chmod 600 /etc/zuvio.env
#   sudo chown root:root /etc/zuvio.env
#
# 這些變數會「覆蓋」settings.json，所以 settings.json 裡可以完全不放帳密。

# Zuvio 帳號（Email）與密碼（必填）
ZUVIO_USER=you@example.com
ZUVIO_PASS=your-zuvio-password

# Telegram 通知（選填；兩個都填才會自動啟用通知）
# Bot Token 找 @BotFather 取得；Chat ID 找 @userinfobot 查詢
ZUVIO_TG_TOKEN=123456:ABC-DEF_your_bot_token
ZUVIO_TG_CHAT_ID=123456789
