[Unit]
Description=Zuvio 自動點名助手 (headless CLI)
# 等網路就緒再啟動，避免開機時搶跑登入失敗
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
# 專案實際存放路徑；若你放在別處請一併修改下面幾個路徑
WorkingDirectory=/home/ubuntu/zuvio-rollcall-bot
# snap 版 Chromium 在使用者目錄下需要 HOME
Environment=HOME=/home/ubuntu
# 讓程式用 snap 的 Chromium 與配對好的 chromedriver（非機密，直接寫在這）
Environment=ZUVIO_CHROME_BIN=/snap/bin/chromium
Environment=ZUVIO_CHROMEDRIVER=/snap/bin/chromium.chromedriver
# 機密（帳密、Telegram）放這個 root-only 檔，不進專案目錄
EnvironmentFile=/etc/zuvio.env
ExecStart=/home/ubuntu/zuvio-rollcall-bot/.venv/bin/python /home/ubuntu/zuvio-rollcall-bot/Zuvio.py --cli
# 崩潰自動重啟；RestartSec 設 30 秒，配合 systemd 預設限流不會被誤判為 flapping
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
