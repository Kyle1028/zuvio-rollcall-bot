[Unit]
Description=Zuvio 自動點名助手 (headless CLI)
# 等網路就緒再啟動，避免開機時搶跑登入失敗
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 以下 @...@ 由 deploy/setup_oracle_linux.sh 依主機實際情況代入
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=HOME=@HOME@
# 瀏覽器本體與配對的 chromedriver（Oracle Linux：EPEL chromium；Ubuntu：snap chromium）
Environment=ZUVIO_CHROME_BIN=@CHROME_BIN@
Environment=ZUVIO_CHROMEDRIVER=@CHROMEDRIVER@
# 心跳檔等執行期狀態放這裡（看門狗 timer 也讀同一個位置）
Environment=ZUVIO_RUNTIME_DIR=@RUNTIME_DIR@
# 機密（帳密、LINE token）放這個 root-only 檔，不進專案目錄
EnvironmentFile=/etc/zuvio.env
ExecStart=@APP_DIR@/.venv/bin/python @APP_DIR@/Zuvio.py --cli
# 崩潰自動重啟；RestartSec 設 30 秒，配合 systemd 預設限流不會被誤判為 flapping
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
